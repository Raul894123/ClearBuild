# ClearBuild · SAQ QURYLYS — переменные окружения бэкенда (БЕЗ секретов)
# Скопируйте в backend/.env (файл в .gitignore). run_backend.bat и run_tests.bat
# подхватывают его сами; в Linux: set -a; . ./.env; set +a
# Все переменные необязательны: без .env работают значения по умолчанию.

# Порт uvicorn для run_backend.bat (по умолчанию 8000; фронтенд ждёт http://localhost:8000/api/v1)
PORT=8000

# База SQLite. По умолчанию — backend/clearbuild_demo.db, создаётся и заполняется
# демо-данными из backend/seed.json при первом запуске. Чтобы пересоздать — удалите файл.
# Относительный путь считается от текущей папки (запускайте из backend/).
# BACKEND_DB_URL=sqlite:///./clearbuild_demo.db
